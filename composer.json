{
    "name": "daria/project-php-itr2",
    "type": "project",
    "scripts": {
        "test": "vendor/bin/phpunit tests --testdox --color",
        "test:coverage": "php -dxdebug.mode=coverage vendor/bin/phpunit tests --coverage-html coverage_report --coverage-filter src"
    },
    "autoload": {
        "psr-4": {
            "src\\": "src/"
        }
    },
    "autoload-dev": {
      "psr-4": {
        "src\\Blog\\UnitTests\\": "tests/"
      }
    },
    "require": {
        "php": "^8.4",
        "fakerphp/faker": "^1.24",
        "ext-pdo": "*",
        "symfony/polyfill-uuid": "^1.33",
        "ext-mbstring": "*",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "monolog/monolog": "^3.9"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpunit/phpunit": "^12.4"
    }
}
